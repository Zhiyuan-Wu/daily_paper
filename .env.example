# V2 API
V2_API_HOST=127.0.0.1
V2_API_PORT=8001

# V2 storage
V2_DATABASE_URL=sqlite:///data/v2_daily_paper.db
V2_ARTIFACT_ROOT=data/v2_artifacts
V2_RESEARCH_ROOT=data/research_runs

# Optional microservice URLs used by status checks
FETCH_SERVICE_URL=http://127.0.0.1:8101
PARSE_SERVICE_URL=http://127.0.0.1:8102
ANALYZE_SERVICE_URL=http://127.0.0.1:8103
RECOMMEND_SERVICE_URL=http://127.0.0.1:8104
RESEARCH_SERVICE_URL=http://127.0.0.1:8105
REPORT_SERVICE_URL=http://127.0.0.1:8106

# Runtime policies
V2_TIMEZONE=Asia/Shanghai
V2_SCHOLAR_PROVIDER=openalex
V2_SCHOLAR_RATE_LIMIT_RPS=2
V2_BATCH_DOWNLOAD_CONCURRENCY=4
V2_BATCH_PARSE_CONCURRENCY=2
V2_BATCH_ANALYZE_CONCURRENCY=2
V2_PDF_LRU_MAX_BYTES=10737418240
V2_PDF_LRU_MAX_COUNT=5000
V2_OCR_TIMEOUT_SECONDS=120
V2_RESEARCH_TIMEOUT_MINUTES=45
V2_EVIDENCE_SNIPPET_MAX_CHARS=300

# OCR integration (for parse method=ocr)
OCR_SERVICE_URL=http://127.0.0.1:8000/generate

# LLM configuration (for compatible integrations)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Logging
V2_LOG_LEVEL=INFO

# Research local fake mode (tests)
V2_RESEARCH_FAKE=0
